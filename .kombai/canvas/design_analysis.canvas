between items-center mb-2\" data-kid=\"53\">\n          <span class=\"text-xs font-bold text-white/30 tracking-widest uppercase italic\" data-kid=\"54\">02 Splash Screen</span>\n          <div class=\"h-px bg-white/10 grow mx-4\" data-kid=\"55\"></div>\n        </div>\n\n        \n        <div class=\"relative w-[340px] aspect-[9/19.5] bg-[#050505] rounded-[55px] border-[12px] border-[#1a1a1a] shadow-[0_40px_100px_rgba(0,0,0,0.8)] overflow-hidden flex flex-col items-center justify-center p-8 ring-1 ring-white/10\" data-kid=\"56\">\n          \n          \n          <div class=\"absolute inset-0 scanlines opacity-30 z-20\" data-kid=\"57\"></div>\n          <div class=\"absolute inset-0 bg-gradient-to-tr from-white/5 to-transparent pointer-events-none opacity-20 z-20\" data-kid=\"58\"></div>\n          \n          \n          <div class=\"relative z-10 flex flex-col items-center\" data-kid=\"59\">\n            \n            <div class=\"mb-12 relative\" data-kid=\"60\">\n               \n               <div class=\"absolute inset-0 bg-[var(--primary-yellow)]/5 blur-3xl rounded-full scale-150\" data-kid=\"61\"></div>\n               <svg viewBox=\"0 0 100 40\" class=\"w-56 glow-yellow fill-none\" data-kid=\"62\">\n                  <path d=\"M5,32 C15,31 25,24 45,23 C65,22 80,27 95,32 M38,23 C45,15 65,15 72,23\" stroke=\"var(--primary-yellow)\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"63\"></path>\n                  <path d=\"M15,32 L85,32\" stroke=\"var(--primary-yellow)\" stroke-opacity=\"0.2\" stroke-width=\"1\" data-kid=\"64\"></path>\n              </svg>\n            </div>\n            \n            <h1 class=\"text-[var(--primary-yellow)] text-6xl font-black tracking-[0.25em] font-modern leading-none drop-shadow-[0_0_20px_rgba(255,199,0,0.25)]\" data-kid=\"65\">DBROS</h1>\n            <p class=\"text-white/30 text-[9px] mt-6 tracking-[0.6em] font-medium uppercase\" data-kid=\"66\">Excellence in Motion</p>\n          </div>\n\n          \n          <div class=\"absolute bottom-12 w-32 h-0.5 bg-white/5 rounded-full overflow-hidden\" data-kid=\"67\">\n             <div class=\"h-full bg-[var(--primary-yellow)]/40 w-1/3 animate-loading\" data-kid=\"68\"></div>\n          </div>\n\n        </div>\n\n        <div class=\"text-center mt-4\" data-kid=\"69\">\n          <p class=\"text-sm text-white/60 font-medium italic\" data-kid=\"70\">Pure Black Fast-Load Splash</p>\n          <div class=\"flex gap-2 justify-center mt-3\" data-kid=\"71\">\n            <span class=\"w-2 h-2 rounded-full bg-white/10\" data-kid=\"72\"></span>\n            <span class=\"w-2 h-2 rounded-full bg-[var(--primary-yellow)]\" data-kid=\"73\"></span>\n            <span class=\"w-2 h-2 rounded-full bg-white/10\" data-kid=\"74\"></span>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n  </div>\n\n  \n  <div class=\"mt-auto pt-8 border-t border-white/5 flex justify-between items-center opacity-40\" data-kid=\"75\">\n    <div class=\"flex items-center gap-4\" data-kid=\"76\">\n      <div class=\"text-[10px] font-bold tracking-widest border border-white/20 px-2 py-1 rounded\" data-kid=\"77\">DBROS</div>\n      <div class=\"text-[10px] font-light\" data-kid=\"78\">Internal Design Asset Release 2026.4</div>\n    </div>\n    <div class=\"text-[10px] font-medium tracking-tighter\" data-kid=\"79\">CONFIDENTIAL & PROPRIETARY</div>\n  </div>\n\n</div>\n",
