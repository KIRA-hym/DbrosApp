      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Lexend:wght@300;400;500;600;700;800&display=swap');\n\n  :root {\n    --primary-yellow: #FFC700;\n    --bg-dark: #121418;\n    --surface-dark: #1F222A;\n    --accent-yellow: #FFC700;\n  }\n\n  .font-modern {\n    font-family: 'Lexend', sans-serif;\n  }\n\n  .scanlines {\n    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.02), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.02));\n    background-size: 100% 2px, 3px 100%;\n    pointer-events: none;\n  }\n\n  .glass-card {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n  }\n\n  .glow-yellow {\n    filter: drop-shadow(0 0 10px rgba(255, 199, 0, 0.6));\n  }\n\n  .gold-gradient {\n    background: linear-gradient(135deg, #FFC700 0%, #FFD700 50%, #B8860B 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar {\n    width: 6px;\n  }\n  ::-webkit-scrollbar-track {\n    background: #000;\n  }\n  ::-webkit-scrollbar-thumb {\n    background: #333;\n    border-radius: 10px;\n  }\n\n  @keyframes loading-bar {\n    0% { transform: translateX(-100%); }\n    100% { transform: translateX(300%); }\n  }\n\n  .animate-loading {\n    animation: loading-bar 2s infinite linear;\n  }\n</style>\n\n<div class=\"w-[1024px] min-h-[800px] bg-[#0A0A0A] text-white p-12 font-modern flex flex-col gap-12 overflow-hidden select-none\" data-kid=\"1\">\n  \n  \n  <div class=\"flex justify-between items-end border-b border-white/10 pb-6\" data-kid=\"2\">\n    <div data-kid=\"3\">\n      <h2 class=\"text-xs uppercase tracking-[0.4em] text-white/40 mb-2 font-light\" data-kid=\"4\">Design Comparison</h2>\n      <h1 class=\"text-4xl font-extrabold tracking-tight\" data-kid=\"5\">System Assets 