      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap');\n  \n  /* Assuming GmarketSans is available in the environment as per instructions.\n     If not, we fallback to a tech-style font. */\n  @font-face {\n    font-family: 'GmarketSans';\n    src: url('https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_2001@1.1/GmarketSansMedium.woff') format('woff');\n    font-weight: normal;\n    font-style: normal;\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    font-family: 'GmarketSans', sans-serif;\n    background-color: #121418;\n    color: #ffffff;\n  }\n\n  .tech-border {\n    border: 2px solid #1F222A;\n  }\n\n  .tech-bg {\n    background-color: #16181D;\n  }\n\n  .font-mono-tech {\n    font-family: 'Space+Mono', monospace;\n  }\n\n  .topo-overlay {\n    background-image: url('https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/treasure-map.svg');\n    background-size: 300px;\n    background-repeat: repeat;\n    opacity: 0.03;\n    pointer-events: none;\n    filter: invert(100%) sepia(100%) saturate(10000%) hue-rotate(45deg);\n  }\n\n  .pulse-yellow {\n    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n  }\n\n  @keyframes pulse {\n    0%, 100% { opacity: 1; }\n    50% { opacity: .3; }\n  }\n\n  .scanline {\n    width: 100%;\n    height: 100px;\n    z-index: 50;\n    background: linear-gradient(0deg, rgba(255,199,0,0) 0%, rgba(255,199,0,0.03) 50%, rgba(255,199,0,0) 100%);\n    opacity: 0.1;\n    position: absolute;\n    bottom: 100%;\n    animation: scan 8s linear infinite;\n  }\n\n  @keyframes scan {\n    0% { bottom: 100%; }\n    100% { bottom: -100px; }\n  }\n</style>\n\n<div class=\"relative min-h-[900px] w-full max-w-[375px] mx-auto overflow-hidden bg-[#121418] border-x border-[#1F222A]\" data-kid=\"1\">\n  \n  <div class=\"absolute inset-0 topo-overlay\" data-kid=\"2\"></div>\n  \n  \n  <div class=\"scanline\" data-kid=\"3\"></div>\n\n  \n  <header class=\"relative z-10 h-20 flex items-center justify-between px-4 border-b-2 border-[#1F222A] bg-[#16181D]/90 backdrop-blur-xl\" data-kid=\"4\">\n    <div class=\"flex items-center gap-2\" data-kid=\"5\">\n      <img src=\"/api/local/images/assets/title.png\" alt=\"Dbros\" class=\"h-8 object-contain\" decoding=\"async\" loading=\"lazy\" data-kid=\"6\">\n    </div>\n    <div class=\"flex flex-col items-end\" data-kid=\"7\">\n      <span class=\"text-[7px] text-[#6E717C] font-black uppercase tracking-[0.2em] leading-none mb-1\" data-kid=\"8\">Telemetry Link</span>\n      <div class=\"flex items-center gap-2 bg-[#FFC700]/5 px-2 py-1 border border-[#FFC700]/20 rounded-xs\" data-kid=\"9\">\n        <span class=\"text-[10px] text-[#FFC700] font-black uppercase tracking-tight\" data-kid=\"10\">Sync: Online</span>\n        <div class=\"w-1.5 h-1.5 rounded-full bg-[#FFC700] pulse-yellow\" data-kid=\"11\"></div>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"relative z-10 p-4 space-y-3\" data-kid=\"12\">\n    \n    \n    <div class=\"flex justify-between items-center px-1\" data-kid=\"13\">\n      <div class=\"text-[9px] text-[#6E717C] font-mono-tech uppercase\" data-kid=\"14\">Lat: 37.5665 | Lon: 126.9780</div>\n      <div class=\"text-[9px] text-[#FFC700] font-mono-tech uppercase\" data-kid=\"15\">Active Session: 04:12:33</div>\n    </div>\n\n    \n    <div class=\"grid grid-cols-2 gap-3\" data-kid=\"16\">\n      \n      <div class=\"relative tech-bg tech-border p-3 overflow-hidden group\" data-kid=\"17\">\n        <div class=\"absolute top-0 right-0 p-1 flex gap-0.5\" data-kid=\"18\">\n          <span class=\"text-[6px] text-[#6E717C] font-mono-tech\" data-kid=\"19\">ID: P-01</span>\n          <div class=\"w-1.5 h-1.5 bg-[#FFC700]\" data-kid=\"20\"></div>\n        </div>\n        <div class=\"text-[8px] text-[#6E717C] font-black tracking-widest uppercase\" data-kid=\"21\">Income Telemetry</div>\n        <div class=\"text-xl font-bold text-[#FFC700] mt-0.5 font-mono-tech tracking-tighter\" data-kid=\"22\">₩1,240,000</div>\n        <div class=\"h-10 mt-2\" data-kid=\"23\">\n          <svg viewBox=\"0 0 100 40\" class=\"w-full h-full\" preserveAspectRatio=\"none\" data-kid=\"24\">\n            <path d=\"M0,35 L10,32 L20,38 L30,25 L40,28 L50,15 L60,20 L70,5 L80,12 L90,8 L100,2\" fill=\"none\" stroke=\"#FFC700\" stroke-width=\"2\" vector-effect=\"non-scaling-stroke\" data-kid=\"25\"></path>\n            <path d=\"M0,35 L10,32 L20,38 L30,25 L40,28 L50,15 L60,20 L70,5 L80,12 L90,8 L100,2 L100,40 L0,40 Z\" fill=\"url(#grad-yellow)\" class=\"opacity-10\" data-kid=\"26\"></path>\n            <defs data-kid=\"27\">\n              <linearGradient id=\"grad-yellow\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\" data-kid=\"28\">\n                <stop offset=\"0%\" style=\"stop-color:#FFC700;stop-opacity:1\" data-kid=\"29\"></stop>\n                <stop offset=\"100%\" style=\"stop-color:#FFC700;stop-opacity:0\" data-kid=\"30\"></stop>\n              </linearGradient>\n            </defs>\n          </svg>\n        </div>\n      </div>\n\n      \n      <div class=\"relative tech-bg tech-border p-3 overflow-hidden group\" data-kid=\"31\">\n        <div class=\"absolute top-0 right-0 p-1 flex gap-0.5\" data-kid=\"32\">\n          <span class=\"text-[6px] text-[#6E717C] font-mono-tech\" data-kid=\"33\">ID: P-02</span>\n          <div class=\"w-1.5 h-1.5 bg-[#6E717C]\" data-kid=\"34\"></div>\n        </div>\n        <div class=\"text-[8px] text-[#6E717C] font-black tracking-widest uppercase\" data-kid=\"35\">Expense Tracking</div>\n        <div class=\"text-xl font-bold text-white mt-0.5 font-mono-tech tracking-tighter\" data-kid=\"36\">₩425,800</div>\n        <div class=\"h-10 mt-2 opacity-50\" data-kid=\"37\">\n          <svg viewBox=\"0 0 100 40\" class=\"w-full h-full\" preserveAspectRatio=\"none\" data-kid=\"38\">\n            <path d=\"M0,10 L10,15 L20,12 L30,20 L40,18 L50,25 L60,22 L70,30 L80,28 L90,35 L100,32\" fill=\"none\" stroke=\"#6E717C\" stroke-width=\"2\" vector-effect=\"non-scaling-stroke\" data-kid=\"39\"></path>\n          </svg>\n        </div>\n      </div>\n\n      \n      <div class=\"relative col-span-2 tech-bg tech-border p-4 overflow-hidden flex items-center justify-between\" data-kid=\"40\">\n        <div class=\"absolute inset-0 opacity-[0.03] pointer-events-none overflow-hidden\" data-kid=\"41\">\n          <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/mountains.svg\" class=\"w-full h-full object-cover scale-110 translate-y-2\" style=\"filter: invert(100%) sepia(100%) saturate(10000%) hue-rotate(45deg);\" data-kid=\"42\">\n        </div>\n        <div class=\"absolute top-0 right-0 p-1 flex gap-0.5\" data-kid=\"43\">\n          <span class=\"text-[6px] text-[#6E717C] font-mono-tech\" data-kid=\"44\">ID: P-03</span>\n        </div>\n        <div class=\"relative z-10\" data-kid=\"45\">\n          <div class=\"text-[8px] text-[#6E717C] font-black tracking-widest uppercase\" data-kid=\"46\">Efficiency Matrix</div>\n          <div class=\"flex items-baseline gap-2 mt-1\" data-kid=\"47\">\n            <span class=\"text-3xl font-black text-[#FFC700] font-mono-tech\" data-kid=\"48\">1.42</span>\n            <span class=\"text-[9px] text-[#6E717C] font-black uppercase tracking-widest\" data-kid=\"49\">Profit / KM</span>\n          </div>\n        </div>\n        <div class=\"relative z-10 flex items-center gap-3\" data-kid=\"50\">\n          <div class=\"w-10 h-10 flex items-center justify-center rounded-full border border-[#FFC700]/30 bg-[#FFC700]/5 shadow-[0_0_15px_rgba(255,199,0,0.1)]\" data-kid=\"51\">\n            <i class=\"ti ti-gauge text-xl text-[#FFC700]\" data-kid=\"52\"></i>\n          </div>\n          <div class=\"text-right\" data-kid=\"53\">\n            <div class=\"text-[7px] text-[#6E717C] uppercase font-black tracking-[0.15em] mb-0.5\" data-kid=\"54\">System Load</div>\n            <div class=\"text-[9px] text-green-400 font-black uppercase tracking-tighter\" data-kid=\"55\">Optimized</div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"tech-bg tech-border p-4 relative overflow-hidden\" data-kid=\"56\">\n      <div class=\"absolute top-1 right-2\" data-kid=\"57\">\n        <span class=\"text-[5px] text-[#6E717C] font-mono-tech tracking-widest opacity-50\" data-kid=\"58\">DATA-SET: WKLY_COMP_04</span>\n      </div>\n      \n      <div class=\"absolute top-0 left-0 w-2 h-2 border-t-2 border-l-2 border-[#1F222A]\" data-kid=\"59\"></div>\n      <div class=\"absolute bottom-0 right-0 w-2 h-2 border-b-2 border-r-2 border-[#1F222A]\" data-kid=\"60\"></div>\n      \n      <div class=\"flex flex-col gap-1 mb-6\" data-kid=\"61\">\n        <div class=\"flex justify-between items-center\" data-kid=\"62\">\n          <div class=\"text-[9px] text-[#6E717C] font-black tracking-[0.1em] uppercase\" data-kid=\"63\">Weekly Telemetry Feed</div>\n          <div class=\"flex gap-3 items-center\" data-kid=\"64\">\n            <div class=\"flex items-center gap-1.5\" data-kid=\"65\">\n              <div class=\"w-2 h-0.5 bg-[#FFC700]\" data-kid=\"66\"></div>\n              <span class=\"text-[7px] text-[#6E717C] font-black uppercase tracking-tighter\" data-kid=\"67\">Revenue</span>\n            </div>\n            <div class=\"flex items-center gap-1.5\" data-kid=\"68\">\n              <div class=\"w-2 h-0.5 bg-[#6E717C]\" data-kid=\"69\"></div>\n              <span class=\"text-[7px] text-[#6E717C] font-black uppercase tracking-tighter\" data-kid=\"70\">Costs</span>\n            </div>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"flex items-end justify-between h-[120px] gap-2 px-1\" data-kid=\"71\">\n        \n        <div class=\"flex-1 flex flex-col items-center gap-1.5 h-full\" data-kid=\"72\">\n          <div class=\"flex-1 w-full flex items-end justify-center gap-[1px]\" data-kid=\"73\">\n            <div class=\"w-full bg-[#FFC700]/80 border-t border-[#FFC700]/50\" style=\"height: 60%;\" data-kid=\"74\"></div>\n            <div class=\"w-full bg-[#1F222A] border-t border-[#6E717C]/50\" style=\"height: 40%;\" data-kid=\"75\"></div>\n          </div>\n          <div class=\"text-[7px] text-[#6E717C] font-mono-tech font-black uppercase\" data-kid=\"76\">Mon</div>\n        </div>\n        <div class=\"flex-1 flex flex-col items-center gap-1.5 h-full\" data-kid=\"77\">\n          <div class=\"flex-1 w-full flex items-end justify-center gap-[1px]\" data-kid=\"78\">\n            <div class=\"w-full bg-[#FFC700]/80 border-t border-[#FFC700]/50\" style=\"height: 80%;\" data-kid=\"79\"></div>\n            <div class=\"w-full bg-[#1F222A] border-t border-[#6E717C]/50\" style=\"height: 30%;\" data-kid=\"80\"></div>\n          </div>\n          <div class=\"text-[7px] text-[#6E717C] font-mono-tech font-black uppercase\" data-kid=\"81\">Tue</div>\n        </div>\n        <div class=\"flex-1 flex flex-col items-center gap-1.5 h-full\" data-kid=\"82\">\n          <div class=\"flex-1 w-full flex items-end justify-center gap-[1px]\" data-kid=\"83\">\n            <div class=\"w-full bg-[#FFC700]/80 border-t border-[#FFC700]/50\" style=\"height: 45%;\" data-kid=\"84\"></div>\n            <div class=\"w-full bg-[#1F222A] border-t border-[#6E717C]/50\" style=\"height: 50%;\" data-kid=\"85\"></div>\n          </div>\n          <div class=\"text-[7px] text-[#6E717C] font-mono-tech font-black uppercase\" data-kid=\"86\">Wed</div>\n        </div>\n        <div class=\"flex-1 flex flex-col items-center gap-1.5 h-full\" data-kid=\"87\">\n          <div class=\"flex-1 w-full flex items-end justify-center gap-[1px]\" data-kid=\"88\">\n            <div class=\"w-full bg-[#FFC700]/80 border-t border-[#FFC700]/50\" style=\"height: 95%;\" data-kid=\"89\"></div>\n            <div class=\"w-full bg-[#1F222A] border-t border-[#6E717C]/50\" style=\"height: 20%;\" data-kid=\"90\"></div>\n          </div>\n          <div class=\"text-[7px] text-[#6E717C] font-mono-tech font-black uppercase\" data-kid=\"91\">Thu</div>\n        </div>\n        <div class=\"flex-1 flex flex-col items-center gap-1.5 h-full\" data-kid=\"92\">\n          <div class=\"flex-1 w-full flex items-end justify-center gap-[1px]\" data-kid=\"93\">\n            <div class=\"w-full bg-[#FFC700]/80 border-t border-[#FFC700]/50\" style=\"height: 70%;\" data-kid=\"94\"></div>\n            <div class=\"w-full bg-[#1F222A] border-t border-[#6E717C]/50\" style=\"height: 35%;\" data-kid=\"95\"></div>\n          </div>\n          <div class=\"text-[7px] text-[#6E717C] font-mono-tech font-black uppercase\" data-kid=\"96\">Fri</div>\n        </div>\n        <div class=\"flex-1 flex flex-col items-center gap-1.5 h-full\" data-kid=\"97\">\n          <div class=\"flex-1 w-full flex items-end justify-center gap-[1px]\" data-kid=\"98\">\n            <div class=\"w-full bg-[#FFC700]/80 border-t border-[#FFC700]/50\" style=\"height: 30%;\" data-kid=\"99\"></div>\n            <div class=\"w-full bg-[#1F222A] border-t border-[#6E717C]/50\" style=\"height: 10%;\" data-kid=\"100\"></div>\n          </div>\n          <div class=\"text-[7px] text-[#6E717C] font-mono-tech font-black uppercase\" data-kid=\"101\">Sat</div>\n        </div>\n        <div class=\"flex-1 flex flex-col items-center gap-1.5 h-full\" data-kid=\"102\">\n          <div class=\"flex-1 w-full flex items-end justify-center gap-[1px]\" data-kid=\"103\">\n            <div class=\"w-full bg-[#FFC700]/80 border-t border-[#FFC700]/50\" style=\"height: 20%;\" data-kid=\"104\"></div>\n            <div class=\"w-full bg-[#1F222A] border-t border-[#6E717C]/50\" style=\"height: 5%;\" data-kid=\"105\"></div>\n          </div>\n          <div class=\"text-[7px] text-[#6E717C] font-mono-tech font-black uppercase\" data-kid=\"106\">Sun</div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"tech-bg tech-border relative overflow-hidden\" data-kid=\"107\">\n      \n      <div class=\"absolute top-0 left-0 w-2 h-2 border-t-2 border-l-2 border-[#1F222A]\" data-kid=\"108\"></div>\n      <div class=\"absolute bottom-0 right-0 w-2 h-2 border-b-2 border-r-2 border-[#1F222A]\" data-kid=\"109\"></div>\n      \n      <div class=\"absolute top-1 right-2\" data-kid=\"110\">\n        <span class=\"text-[5px] text-[#6E717C] font-mono-tech tracking-widest opacity-50\" data-kid=\"111\">X-LEDGER: L_SEG_00</span>\n      </div>\n      \n      <div class=\"grid grid-cols-4 border-b-2 border-[#1F222A] bg-[#1F222A]/60 px-3 py-3\" data-kid=\"112\">\n        <div class=\"text-[8px] text-[#6E717C] font-black uppercase tracking-[0.12em]\" data-kid=\"113\">Timestamp</div>\n        <div class=\"text-[8px] text-[#6E717C] font-black uppercase tracking-[0.12em]\" data-kid=\"114\">Sector</div>\n        <div class=\"text-[8px] text-[#6E717C] font-black uppercase tracking-[0.12em] text-right\" data-kid=\"115\">Delta</div>\n        <div class=\"text-[8px] text-[#6E717C] font-black uppercase tracking-[0.12em] text-right\" data-kid=\"116\">Balance</div>\n      </div>\n\n      \n      <div class=\"divide-y divide-[#1F222A]/50\" data-kid=\"117\">\n        <div class=\"grid grid-cols-4 px-3 py-2.5 items-center bg-[#FFC700]/10 border-l-[3px] border-[#FFC700]\" data-kid=\"118\">\n          <div class=\"text-[10px] text-white font-mono-tech\" data-kid=\"119\">14:22:05</div>\n          <div class=\"text-[8px] text-[#FFC700] font-bold uppercase tracking-widest\" data-kid=\"120\">Revenue</div>\n          <div class=\"text-[10px] text-white font-mono-tech text-right font-bold tracking-tighter\" data-kid=\"121\">+₩12,400</div>\n          <div class=\"text-[9px] text-[#6E717C] font-mono-tech text-right\" data-kid=\"122\">1.240m</div>\n        </div>\n        <div class=\"grid grid-cols-4 px-3 py-2.5 items-center hover:bg-[#1F222A] transition-colors border-l-[3px] border-transparent\" data-kid=\"123\">\n          <div class=\"text-[10px] text-[#6E717C] font-mono-tech\" data-kid=\"124\">12:15:30</div>\n          <div class=\"text-[8px] text-[#6E717C] font-bold uppercase tracking-widest\" data-kid=\"125\">Fuel</div>\n          <div class=\"text-[10px] text-white font-mono-tech text-right tracking-tighter\" data-kid=\"126\">-₩45,000</div>\n          <div class=\"text-[9px] text-[#6E717C] font-mono-tech text-right\" data-kid=\"127\">1.227m</div>\n        </div>\n        <div class=\"grid grid-cols-4 px-3 py-2.5 items-center hover:bg-[#1F222A] transition-colors border-l-[3px] border-transparent\" data-kid=\"128\">\n          <div class=\"text-[10px] text-[#6E717C] font-mono-tech\" data-kid=\"129\">09:10:12</div>\n          <div class=\"text-[8px] text-[#FFC700] font-bold uppercase tracking-widest\" data-kid=\"130\">Revenue</div>\n          <div class=\"text-[10px] text-white font-mono-tech text-right font-bold tracking-tighter\" data-kid=\"131\">+₩32,000</div>\n          <div class=\"text-[9px] text-[#6E717C] font-mono-tech text-right\" data-kid=\"132\">1.272m</div>\n        </div>\n        <div class=\"grid grid-cols-4 px-3 py-2.5 items-center hover:bg-[#1F222A] transition-colors border-l-[3px] border-transparent\" data-kid=\"133\">\n          <div class=\"text-[10px] text-[#6E717C] font-mono-tech\" data-kid=\"134\">08:00:00</div>\n          <div class=\"text-[8px] text-[#6E717C] font-bold uppercase tracking-widest\" data-kid=\"135\">Maintenance</div>\n          <div class=\"text-[10px] text-white font-mono-tech text-right tracking-tighter\" data-kid=\"136\">-₩8,500</div>\n          <div class=\"text-[9px] text-[#6E717C] font-mono-tech text-right\" data-kid=\"137\">1.240m</div>\n        </div>\n        <div class=\"grid grid-cols-4 px-3 py-2.5 items-center hover:bg-[#1F222A] transition-colors border-l-[3px] border-transparent\" data-kid=\"138\">\n          <div class=\"text-[10px] text-[#6E717C] font-mono-tech\" data-kid=\"139\">07:45:11</div>\n          <div class=\"text-[8px] text-[#FFC700] font-bold uppercase tracking-widest\" data-kid=\"140\">Revenue</div>\n          <div class=\"text-[10px] text-white font-mono-tech text-right font-bold tracking-tighter\" data-kid=\"141\">+₩18,200</div>\n          <div class=\"text-[9px] text-[#6E717C] font-mono-tech text-right\" data-kid=\"142\">1.248m</div>\n        </div>\n      </div>\n      \n      \n      <div class=\"p-2 border-t border-[#1F222A] flex justify-center\" data-kid=\"143\">\n        <div class=\"text-[8px] text-[#6E717C] font-bold uppercase tracking-widest flex items-center gap-2\" data-kid=\"144\">\n          <i class=\"ti ti-database\" data-kid=\"145\"></i>\n          End of Ledger Segment 0x4F2A\n        </div>\n      </div>\n    </div>\n\n  </main>\n\n  \n  <nav class=\"relative z-10 mx-4 mb-6 tech-bg tech-border flex items-stretch h-14 overflow-hidden divide-x divide-[#1F222A]\" data-kid=\"146\">\n    \n    <div class=\"absolute top-0 left-0 w-1 h-1 border-t border-l border-[#FFC700]/30\" data-kid=\"147\"></div>\n    <div class=\"absolute bottom-0 right-0 w-1 h-1 border-b border-r border-[#FFC700]/30\" data-kid=\"148\"></div>\n    \n    <button class=\"flex-1 flex flex-col items-center justify-center gap-1 group\" data-kid=\"149\">\n      <i class=\"ti ti-home text-lg text-[#FFC700]\" data-kid=\"150\"></i>\n      <span class=\"text-[8px] font-black uppercase tracking-widest text-[#FFC700]\" data-kid=\"151\">Home</span>\n    </button>\n    <button class=\"flex-1 flex flex-col items-center justify-center gap-1 group opacity-40 hover:opacity-100 transition-opacity\" data-kid=\"152\">\n      <i class=\"ti ti-list text-lg text-white\" data-kid=\"153\"></i>\n      <span class=\"text-[8px] font-black uppercase tracking-widest text-white\" data-kid=\"154\">Logs</span>\n    </button>\n    <button class=\"flex-1 flex flex-col items-center justify-center gap-1 group bg-[#FFC700] hover:bg-[#FFD700] transition-colors\" data-kid=\"155\">\n      <i class=\"ti ti-plus text-xl text-black\" data-kid=\"156\"></i>\n    </button>\n    <button class=\"flex-1 flex flex-col items-center justify-center gap-1 group opacity-40 hover:opacity-100 transition-opacity\" data-kid=\"157\">\n      <i class=\"ti ti-chart-bar text-lg text-white\" data-kid=\"158\"></i>\n      <span class=\"text-[8px] font-black uppercase tracking-widest text-white\" data-kid=\"159\">Stats</span>\n    </button>\n    <button class=\"flex-1 flex flex-col items-center justify-center gap-1 group opacity-40 hover:opacity-100 transition-opacity\" data-kid=\"160\">\n      <i class=\"ti ti-settings text-lg text-white\" data-kid=\"161\"></i>\n      <span class=\"text-[8px] font-black uppercase tracking-widest text-white\" data-kid=\"162\">Config</span>\n    </button>\n  </nav>\n\n  \n  <footer class=\"relative z-10 px-4 pb-6 flex justify-between items-center\" data-kid=\"163\">\n    <div class=\"text-[7px] text-[#6E717C] font-mono-tech uppercase\" data-kid=\"164\">Kernel: v4.2.0-TELEMETRY</div>\n    <div class=\"text-[7px] text-[#6E717C] font-mono-tech uppercase\" data-kid=\"165\">© 2026 DBROS SYSTEMS</div>\n  </footer>\n</div>\n\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"166\">\n",
