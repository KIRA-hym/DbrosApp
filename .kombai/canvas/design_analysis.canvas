      "html": "\n<div class=\"min-h-[900px] w-full bg-[#121418] text-white p-8 md:p-16 font-sans relative overflow-hidden\" data-kid=\"0\">\n  <div class=\"absolute inset-0 technical-grid pointer-events-none\" data-kid=\"1\"></div>\n  \n  <style data-kid=\"2\">\n    @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;700&display=swap');\n\n    .tech-font {\n      font-family: 'Chakra Petch', sans-serif;\n    }\n    .mono-font {\n      font-family: 'JetBrains Mono', monospace;\n    }\n    \n    /* Custom Scan Animation */\n    @keyframes scanner {\n      0% { top: 20%; opacity: 0; }\n      15% { opacity: 1; }\n      85% { opacity: 1; }\n      100% { top: 80%; opacity: 0; }\n    }\n\n    .animate-scan {\n      animation: scanner 4s ease-in-out infinite;\n    }\n\n    .technical-grid {\n      background-image: linear-gradient(rgba(255, 199, 0, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 199, 0, 0.03) 1px, transparent 1px);\n      background-size: 40px 40px;\n    }\n\n    /* Glitch effect for technical feel */\n    .tech-border {\n      position: relative;\n    }\n    .tech-border::before {\n      content: '';\n      position: absolute;\n      top: -1px; left: -1px; right: -1px; bottom: -1px;\n      border: 1px solid rgba(255, 199, 0, 0.15);\n      pointer-events: none;\n    }\n\n    .topo-bg {\n      background-image: url('https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/treasure-map.svg');\n      background-size: cover;\n      background-position: center;\n      filter: invert(1) opacity(0.12);\n    }\n  </style>\n\n  \n  <div class=\"max-w-6xl mx-auto mb-16 border-b border-[#1F222A] pb-8 flex flex-col md:flex-row justify-between items-end gap-6\" data-kid=\"3\">\n    <div class=\"flex flex-col gap-2\" data-kid=\"4\">\n      <div class=\"flex items-center gap-3\" data-kid=\"5\">\n        <div class=\"w-12 h-1 bg