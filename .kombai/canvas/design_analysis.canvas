      "html": "\n<div class=\"w-full bg-[#000000] text-white font-sans relative overflow-hidden flex flex-col items-center justify-between min-h-[812px]\" style=\"height: 812px;\" data-kid=\"0\">\n  \n  <div class=\"absolute inset-0 pointer-events-none opacity-5\" style=\"background-image: linear-gradient(rgba(255, 199, 0, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 199, 0, 0.1) 1px, transparent 1px); background-size: 30px 30px;\" data-kid=\"1\"></div>\n  \n  \n  <div class=\"absolute inset-0 opacity-[0.025] pointer-events-none\" style=\"background-image: url('https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/treasure-map.svg'); background-size: 120%; background-position: center; filter: invert(1);\" data-kid=\"2\"></div>\n\n  \n  <div class=\"w-full px-8 pt-12 flex justify-between items-start z-10 relative\" data-kid=\"3\">\n    <div class=\"flex flex-col gap-1.5\" data-kid=\"4\">\n      <div class=\"flex items-center gap-2\" data-kid=\"5\">\n        <div class=\"w-1.5 h-1.5 bg-[#FFC700] rounded-full animate-pulse shadow-[0_0_8px_rgba(255,199,0,0.8)]\" data-kid=\"6\"></div>\n        <span class=\"mono-font text-[10px] text-[#FFC700] uppercase tracking-widest font-bold\" data-kid=\"7\">System_Sync</span>\n      </div>\n      <span class=\"mono-font text-[9px] text-white/40 uppercase tracking-tighter\" data-kid=\"8\">LAT: 37.5665 | LONG: 126.9780</span>\n    </div>\n    <div class=\"text-right flex flex-col gap-1\" data-kid=\"9\">\n      <span class=\"tech-font text-[10px] text-white/60 uppercase font-bold tracking-widest\" data-kid=\"10\">v3.01_Rev_A</span>\n      <div class=\"flex items-center justify-end gap-1.5\" data-kid=\"11\">\n        <div class=\"w-8 h-1 bg-[#1F222A] rounded-full overflow-hidden\" data-kid=\"12\">\n          <div class=\"h-full bg-[#FFC700] w-[65%] animate-[pulse_1.5s_infinite]\" data-kid=\"13\"></div>\n        </div>\n        <span class=\"mono-font text-[8px] text-white/30 uppercase\" data-kid=\"14\">Telemetry</span>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"relative w-full flex flex-col items-center justify-center flex-1\" data-kid=\"15\">\n    \n    <div class=\"absolute w-[280px] h-[280px] border border-[#FFC700]/10 rounded-full animate-[spin_20s_linear_infinite]\" data-kid=\"16\"></div>\n    <div class=\"absolute w-[310px] h-[310px] border border-[#FFC700]/5 rounded-full border-dashed animate-[spin_30s_linear_infinite_reverse]\" data-kid=\"17\"></div>\n    \n    \n    <div class=\"absolute w-[240px] h-[240px] pointer-events-none\" data-kid=\"18\">\n      <div class=\"absolute top-0 left-0 w-6 h-6 border-t border-l border-[#FFC700]/40\" data-kid=\"19\"></div>\n      <div class=\"absolute top-0 right-0 w-6 h-6 border-t border-r border-[#FFC700]/40\" data-kid=\"20\"></div>\n      <div class=\"absolute bottom-0 left-0 w-6 h-6 border-b border-l border-[#FFC700]/40\" data-kid=\"21\"></div>\n      <div class=\"absolute bottom-0 right-0 w-6 h-6 border-b border-r border-[#FFC700]/40\" data-kid=\"22\"></div>\n    </div>\n\n    \n    <div class=\"relative z-20 w-[240px] h-[240px] flex items-center justify-center p-2 overflow-hidden\" data-kid=\"23\">\n      <img src=\"/api/local/images/assets/icon_before_text.png\" alt=\"Dbros Logo\" class=\"w-full h-full object-contain relative z-10 drop-shadow-[0_0_30px_rgba(255,199,0,0.3)] mix-blend-screen\" decoding=\"async\" loading=\"lazy\" data-kid=\"24\">\n      \n      \n      <div class=\"absolute left-[-20%] right-[-20%] h-[2px] bg-gradient-to-r from-transparent via-[#FFC700] to-transparent shadow-[0_0_30px_#FFC700,0_0_60px_rgba(255,199,0,0.6)] animate-scan z-30\" data-kid=\"25\"></div>\n      \n      \n      <div class=\"absolute left-[-20%] right-[-20%] h-32 bg-gradient-to-b from-[#FFC700]/15 to-transparent animate-scan-beam z-25 pointer-events-none\" data-kid=\"26\"></div>\n    </div>\n\n    \n    <div class=\"mt-8 px-3 py-1 bg-[#1F222A]/50 border border-[#FFC700]/20 rounded-sm\" data-kid=\"27\">\n      <span class=\"mono-font text-[9px] text-[#FFC700]/80 uppercase tracking-[0.2em]\" data-kid=\"28\">Asset_ID: DBROS_CORE_01</span>\n    </div>\n  </div>\n\n  \n  <div class=\"w-full px-8 pb-16 flex flex-col items-center gap-12 z-10 relative\" data-kid=\"29\">\n    \n    <div class=\"flex flex-col items-center gap-6\" data-kid=\"30\">\n      <h1 class=\"text-3xl font-bold text-white tracking-[0.2em] drop-shadow-[0_0_20px_rgba(255,255,255,0.2)]\" style=\"font-family: 'GmarketSans', sans-serif;\" data-kid=\"31\">운행일지관리</h1>\n      <div class=\"flex items-center gap-4\" data-kid=\"32\">\n        <div class=\"w-10 h-[1px] bg-gradient-to-r from-transparent via-[#FFC700]/40 to-[#FFC700]/10\" data-kid=\"33\"></div>\n        <span class=\"mono-font text-[9px] text-white/70 uppercase tracking-[0.3em] animate-pulse whitespace-nowrap\" data-kid=\"34\">Initializing_Core</span>\n        <div class=\"w-10 h-[1px] bg-gradient-to-l from-transparent via-[#FFC700]/40 to-[#FFC700]/10\" data-kid=\"35\"></div>\n      </div>\n    </div>\n\n    \n    <div class=\"w-full pt-6 border-t border-white/5 flex justify-between items-center\" data-kid=\"36\">\n      <div class=\"flex flex-col gap-1.5\" data-kid=\"37\">\n        <span class=\"mono-font text-[8px] text-white/30 uppercase tracking-widest font-medium\" data-kid=\"38\">© 2026 DBROS INC. ALL RIGHTS RESERVED.</span>\n        <div class=\"flex items-center gap-2\" data-kid=\"39\">\n          <div class=\"w-1 h-1 bg-green-500 rounded-full shadow-[0_0_5px_rgba(34,197,94,0.6)]\" data-kid=\"40\"></div>\n          <span class=\"mono-font text-[7px] text-white/40 uppercase font-bold tracking-wider\" data-kid=\"41\">SECURE_PROTO_V2_ENCRYPTED</span>\n        </div>\n      </div>\n      <div class=\"flex gap-1.5 items-center\" data-kid=\"42\">\n        <div class=\"w-1 h-4 bg-[#FFC700]/40\" data-kid=\"43\"></div>\n        <div class=\"w-1 h-4 bg-[#FFC700]/20\" data-kid=\"44\"></div>\n        <div class=\"w-1 h-4 bg-[#FFC700]/5\" data-kid=\"45\"></div>\n      </div>\n    </div>\n  </div>\n\n  <style data-kid=\"46\">\n    @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;700&display=swap');\n    \n    @font-face {\n      font-family: 'GmarketSans';\n      src: url('https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_2001@1.1/GmarketSansMedium.woff') format('woff');\n      font-weight: 500;\n      font-style: normal;\n    }\n\n    .tech-font {\n      font-family: 'Chakra Petch', sans-serif;\n    }\n    .mono-font {\n      font-family: 'JetBrains Mono', monospace;\n    }\n\n    /* Scan Animation */\n    @keyframes scanner {\n      0% { top: -5%; opacity: 0; }\n      15% { opacity: 1; }\n      85% { opacity: 1; }\n      100% { top: 105%; opacity: 0; }\n    }\n\n    @keyframes scanner-beam {\n      0% { top: -30%; opacity: 0; }\n      15% { opacity: 1; }\n      85% { opacity: 1; }\n      100% { top: 80%; opacity: 0; }\n    }\n\n    .animate-scan {\n      animation: scanner 3.5s ease-in-out infinite, flicker 0.15s infinite;\n    }\n\n    @keyframes flicker {\n      0%, 100% { opacity: 1; }\n      50% { opacity: 0.85; }\n    }\n\n    .animate-scan-beam {\n      animation: scanner-beam 3.5s ease-in-out infinite;\n    }\n\n    /* Pulse override if needed */\n    @keyframes pulse-custom {\n      0%, 100% { opacity: 1; }\n      50% { opacity: 0.3; }\n    }\n  </style>\n</div>\n",
