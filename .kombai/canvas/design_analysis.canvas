      "html": "\n<div class=\"min-h-[950px] w-full bg-[#121418] text-white font-['GmarketSans'] flex flex-col relative pb-36 overflow-hidden\" data-kid=\"0\">\n    <div class=\"absolute inset-0 bg-grain pointer-events-none\" data-kid=\"1\"></div>\n    <style data-kid=\"2\">\n        @import url('https://webfontworld.github.io/gmarket/GmarketSans.css');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .glass-panel {\n            background: rgba(31, 34, 42, 0.85);\n            backdrop-filter: blur(20px);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n        }\n\n        .glass-panel-active {\n            background: linear-gradient(135deg, rgba(31, 34, 42, 0.9), rgba(255, 199, 0, 0.05));\n            border: 1px solid rgba(255, 199, 0, 0.3);\n            box-shadow: 0 0 30px rgba(255, 199, 0, 0.1);\n        }\n\n        .bg-grain {\n            background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n            opacity: 0.03;\n        }\n\n        .yellow-glow {\n            text-shadow: 0 0 12px rgba(255, 199, 0, 0.4);\n        }\n\n        .chart-glow {\n            filter: drop-shadow(0 0 8px rgba(255, 199, 0, 0.5));\n        }\n\n        /* Custom scrollbar for better automotive look */\n        ::-webkit-scrollbar {\n            width: 4px;\n        }\n        ::-webkit-scrollbar-track {\n            background: transparent;\n        }\n        ::-webkit-scrollbar-thumb {\n            background: rgba(255, 199, 0, 0.2);\n            border-radius: 10px;\n        }\n    </style>\n\n    \n    <header class=\"absolute top-0 left-0 right-0 z-50 bg-[#121418]/90 backdrop-blur-xl border-b border-white/5 py-4 px-5 flex items-center justify-between shadow-2xl\" data-kid=\"3\">\n        <div class=\"w-10 h-10 rounded-full border border-white/10 p-0.5 overflow-hidden\" data-kid=\"4\">\n            <img src=\"https://i.pravatar.cc/100?u=dbros\" alt=\"User\" class=\"w-full h-full rounded-full object-cover grayscale\" data-kid=\"5\">\n        </div>\n        <img src=\"/api/local/images/assets/title.png\" alt=\"Dbros\" class=\"h-9 object-contain drop-shadow-[0_0_8px_rgba(255,199,0,0.3)]\" data-kid=\"6\">\n        <div class=\"relative w-10 h-10 flex items-center justify-end\" data-kid=\"7\">\n            <i class=\"ti ti-bell text-xl text-[#9499A5] hover:text-[#FFC700] transition-colors\" data-kid=\"8\"></i>\n            <span class=\"absolute top-2.5 right-2.5 w-2 h-2 bg-[#FFC700] rounded-full ring-2 ring-[#121418]\" data-kid=\"9\"></span>\n        </div>\n    </header>\n\n    <main class=\"flex-1 px-4 pt-24 pb-12 space-y-6\" data-kid=\"10\">\n        \n        <div class=\"flex justify-between items-end px-1\" data-kid=\"11\">\n            <div data-kid=\"12\">\n                <h1 class=\"text-[10px] text-[#9499A5] uppercase tracking-widest font-bold mb-1 opacity-80\" data-kid=\"13\">DASHBOARD COMMAND</h1>\n                <p class=\"text-2xl font-bold tracking-tight\" data-kid=\"14\">Welcome, <span class=\"text-[#FFC700]\" data-kid=\"15\">Driver #0812</span></p>\n            </div>\n            <div class=\"text-right pb-1\" data-kid=\"16\">\n                <p class=\"text-[10px] text-[#9499A5] font-bold\" data-kid=\"17\">MAY 24, 2024</p>\n                <p class=\"text-xs font-bold text-[#FFC700] tracking-wider\" data-kid=\"18\">09:42 AM</p>\n            </div>\n        </div>\n\n        \n        <div class=\"grid grid-cols-2 gap-3.5\" data-kid=\"19\">\n            \n            <div class=\"glass-panel rounded-2xl p-5 flex flex-col justify-between h-[110px] hover:border-[#FFC700]/40 transition-all cursor-pointer group\" data-kid=\"20\">\n                <div class=\"flex justify-between items-start\" data-kid=\"21\">\n                    <span class=\"text-[10px] text-[#9499A5] font-bold uppercase tracking-wider\" data-kid=\"22\">Income</span>\n                    <i class=\"ti ti-trending-up text-[#FFC700] opacity-50 group-hover:opacity-100 transition-opacity\" data-kid=\"23\"></i>\n                </div>\n                <div data-kid=\"24\">\n                    <span class=\"text-xl font-bold text-[#FFC700] yellow-glow\" data-kid=\"25\">₩ 842,500</span>\n                    <div class=\"text-[9px] text-[#9499A5] mt-1\" data-kid=\"26\">+12.4% vs prev. day</div>\n                </div>\n            </div>\n\n            \n            <div class=\"glass-panel rounded-2xl p-5 flex flex-col justify-between h-[110px] hover:border-red-500/40 transition-all cursor-pointer group\" data-kid=\"27\">\n                <div class=\"flex justify-between items-start\" data-kid=\"28\">\n                    <span class=\"text-[10px] text-[#9499A5] font-bold uppercase tracking-wider\" data-kid=\"29\">Expenses</span>\n                    <i class=\"ti ti-trending-down text-red-400 opacity-50 group-hover:opacity-100 transition-opacity\" data-kid=\"30\"></i>\n                </div>\n                <div data-kid=\"31\">\n                    <span class=\"text-xl font-bold text-white\" data-kid=\"32\">₩ 124,300</span>\n                    <div class=\"text-[9px] text-[#9499A5] mt-1\" data-kid=\"33\">-2.1% vs avg</div>\n                </div>\n            </div>\n\n            \n            <div class=\"glass-panel glass-panel-active rounded-2xl p-5 flex flex-col justify-between h-[110px] relative overflow-hidden\" data-kid=\"34\">\n                <div class=\"absolute -right-4 -top-4 w-16 h-16 bg-[#FFC700]/5 rounded-full blur-2xl\" data-kid=\"35\"></div>\n                <div class=\"flex justify-between items-start relative z-10\" data-kid=\"36\">\n                    <span class=\"text-[10px] text-[#FFC700] font-bold uppercase tracking-wider\" data-kid=\"37\">Net Profit</span>\n                    <div class=\"flex h-5 w-5 items-center justify-center rounded-full bg-[#FFC700]/10\" data-kid=\"38\">\n                        <i class=\"ti ti-wallet text-[#FFC700] text-xs\" data-kid=\"39\"></i>\n                    </div>\n                </div>\n                <div class=\"relative z-10\" data-kid=\"40\">\n                    <span class=\"text-2xl font-bold text-[#FFC700] yellow-glow\" data-kid=\"41\">₩ 718,200</span>\n                </div>\n            </div>\n\n            \n            <div class=\"glass-panel rounded-2xl p-5 flex flex-col justify-between h-[110px]\" data-kid=\"42\">\n                <div class=\"flex justify-between items-start\" data-kid=\"43\">\n                    <span class=\"text-[10px] text-[#9499A5] font-bold uppercase tracking-wider\" data-kid=\"44\">Distance</span>\n                    <i class=\"ti ti-car text-blue-400 opacity-50\" data-kid=\"45\"></i>\n                </div>\n                <div data-kid=\"46\">\n                    <span class=\"text-xl font-bold text-white\" data-kid=\"47\">186.4 <span class=\"text-xs font-normal text-[#9499A5]\" data-kid=\"48\">km</span></span>\n                </div>\n            </div>\n        </div>\n\n        \n        <div class=\"glass-panel rounded-3xl p-6 shadow-inner\" data-kid=\"49\">\n            <div class=\"flex justify-between items-center mb-8\" data-kid=\"50\">\n                <div data-kid=\"51\">\n                    <h3 class=\"text-base font-bold tracking-tight\" data-kid=\"52\">Earnings Report</h3>\n                    <p class=\"text-[10px] text-[#9499A5] font-medium tracking-wide\" data-kid=\"53\">Performance vs Target</p>\n                </div>\n                <div class=\"flex items-center gap-1 bg-black/40 rounded-lg p-1.5 border border-white/5\" data-kid=\"54\">\n                    <button class=\"px-3 py-1 text-[10px] font-bold bg-[#FFC700] text-black rounded-md transition-all shadow-md\" data-kid=\"55\">W</button>\n                    <button class=\"px-3 py-1 text-[10px] font-bold text-[#6E717C] hover:text-white transition-all\" data-kid=\"56\">M</button>\n                    <button class=\"px-3 py-1 text-[10px] font-bold text-[#6E717C] hover:text-white transition-all\" data-kid=\"57\">Y</button>\n                </div>\n            </div>\n\n            <div class=\"h-44 w-full relative\" data-kid=\"58\">\n                <svg class=\"w-full h-full\" viewBox=\"0 0 400 150\" preserveAspectRatio=\"none\" data-kid=\"59\">\n                    <defs data-kid=\"60\">\n                        <linearGradient id=\"chartGradient\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\" data-kid=\"61\">\n                            <stop offset=\"0%\" stop-color=\"#FFC700\" stop-opacity=\"0.3\" data-kid=\"62\"></stop>\n                            <stop offset=\"100%\" stop-color=\"#FFC700\" stop-opacity=\"0\" data-kid=\"63\"></stop>\n                        </linearGradient>\n                    </defs>\n                    \n                    \n                    <line x1=\"10%\" y1=\"0\" x2=\"10%\" y2=\"150\" stroke=\"white\" stroke-opacity=\"0.03\" data-kid=\"64\"></line>\n                    <line x1=\"30%\" y1=\"0\" x2=\"30%\" y2=\"150\" stroke=\"white\" stroke-opacity=\"0.03\" data-kid=\"65\"></line>\n                    <line x1=\"50%\" y1=\"0\" x2=\"50%\" y2=\"150\" stroke=\"white\" stroke-opacity=\"0.03\" data-kid=\"66\"></line>\n                    <line x1=\"70%\" y1=\"0\" x2=\"70%\" y2=\"150\" stroke=\"white\" stroke-opacity=\"0.03\" data-kid=\"67\"></line>\n                    <line x1=\"90%\" y1=\"0\" x2=\"90%\" y2=\"150\" stroke=\"white\" stroke-opacity=\"0.03\" data-kid=\"68\"></line>\n\n                    \n                    <line x1=\"0\" y1=\"40\" x2=\"400\" y2=\"40\" stroke=\"white\" stroke-opacity=\"0.03\" data-kid=\"69\"></line>\n                    <line x1=\"0\" y1=\"80\" x2=\"400\" y2=\"80\" stroke=\"white\" stroke-opacity=\"0.03\" data-kid=\"70\"></line>\n                    <line x1=\"0\" y1=\"120\" x2=\"400\" y2=\"120\" stroke=\"white\" stroke-opacity=\"0.03\" data-kid=\"71\"></line>\n\n                    \n                    <path d=\"M0,120 Q50,110 100,105 T200,60 T300,40 T400,50 L400,150 L0,150 Z\" fill=\"url(#chartGradient)\" data-kid=\"72\"></path>\n                    \n                    \n                    <path d=\"M0,140 Q40,135 80,138 T160,120 T240,125 T320,110 T400,115\" fill=\"none\" stroke=\"#6E717C\" stroke-width=\"2\" stroke-dasharray=\"4,2\" opacity=\"0.4\" data-kid=\"73\"></path>\n                    \n                    \n                    <path d=\"M0,120 Q50,110 100,105 T200,60 T300,40 T400,50\" fill=\"none\" stroke=\"#FFC700\" stroke-width=\"3\" class=\"chart-glow\" stroke-linecap=\"round\" data-kid=\"74\"></path>\n                    \n                    \n                    <circle cx=\"200\" cy=\"60\" r=\"4\" fill=\"#FFC700\" class=\"chart-glow\" data-kid=\"75\"></circle>\n                    <circle cx=\"300\" cy=\"40\" r=\"4\" fill=\"#FFC700\" class=\"chart-glow\" data-kid=\"76\"></circle>\n                </svg>\n            </div>\n            \n            <div class=\"flex justify-between mt-4\" data-kid=\"77\">\n                <span class=\"text-[8px] text-[#6E717C] font-bold\" data-kid=\"78\">MON</span>\n                <span class=\"text-[8px] text-[#6E717C] font-bold\" data-kid=\"79\">TUE</span>\n                <span class=\"text-[8px] text-[#6E717C] font-bold\" data-kid=\"80\">WED</span>\n                <span class=\"text-[8px] text-[#FFC700] font-bold\" data-kid=\"81\">THU</span>\n                <span class=\"text-[8px] text-[#6E717C] font-bold\" data-kid=\"82\">FRI</span>\n                <span class=\"text-[8px] text-[#6E717C] font-bold\" data-kid=\"83\">SAT</span>\n                <span class=\"text-[8px] text-[#6E717C] font-bold\" data-kid=\"84\">SUN</span>\n            </div>\n        </div>\n\n        \n        <div class=\"space-y-4\" data-kid=\"85\">\n            <div class=\"flex justify-between items-center px-2\" data-kid=\"86\">\n                <h3 class=\"text-base font-bold flex items-center gap-2.5\" data-kid=\"87\">\n                    <span class=\"relative flex h-2 w-2\" data-kid=\"88\">\n                        <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-[#FFC700] opacity-75\" data-kid=\"89\"></span>\n                        <span class=\"relative inline-flex rounded-full h-2 w-2 bg-[#FFC700]\" data-kid=\"90\"></span>\n                    </span>\n                    Recent Driving Logs\n                </h3>\n                <button class=\"text-[10px] text-[#FFC700] font-bold tracking-widest hover:opacity-70 transition-opacity\" data-kid=\"91\">VIEW HISTORY</button>\n            </div>\n            \n            <div class=\"space-y-3\" data-kid=\"92\">\n                \n                <div class=\"glass-panel rounded-2xl p-4 flex items-center gap-4 hover:bg-white/5 transition-all cursor-pointer group\" data-kid=\"93\">\n                    <div class=\"w-12 h-12 rounded-xl bg-white/5 flex items-center justify-center border border-white/10 group-hover:border-[#FFC700]/30 transition-all\" data-kid=\"94\">\n                        <i class=\"ti ti-car text-xl text-[#FFC700]\" data-kid=\"95\"></i>\n                    </div>\n                    <div class=\"flex-1\" data-kid=\"96\">\n                        <div class=\"flex items-center gap-2 mb-0.5\" data-kid=\"97\">\n                            <span class=\"text-xs font-bold\" data-kid=\"98\">Gangnam-gu → Incheon Int'l</span>\n                            <span class=\"px-1.5 py-0.5 rounded bg-[#FFC700]/10 text-[#FFC700] text-[8px] font-bold uppercase\" data-kid=\"99\">Prime</span>\n                        </div>\n                        <div class=\"text-[10px] text-[#6E717C] font-medium flex items-center gap-2\" data-kid=\"100\">\n                            <span data-kid=\"101\">14:30 - 15:45</span>\n                            <span class=\"w-1 h-1 rounded-full bg-white/20\" data-kid=\"102\"></span>\n                            <span data-kid=\"103\">52.4 km</span>\n                        </div>\n                    </div>\n                    <div class=\"text-right\" data-kid=\"104\">\n                        <div class=\"text-sm font-bold text-[#FFC700]\" data-kid=\"105\">+₩ 85,200</div>\n                        <div class=\"text-[9px] text-[#6E717C]\" data-kid=\"106\">Settled</div>\n                    </div>\n                </div>\n\n                \n                <div class=\"glass-panel rounded-2xl p-4 flex items-center gap-4 hover:bg-white/5 transition-all cursor-pointer group\" data-kid=\"107\">\n                    <div class=\"w-12 h-12 rounded-xl bg-white/5 flex items-center justify-center border border-white/10 group-hover:border-red-500/30 transition-all\" data-kid=\"108\">\n                        <i class=\"ti ti-briefcase text-xl text-white/40\" data-kid=\"109\"></i>\n                    </div>\n                    <div class=\"flex-1\" data-kid=\"110\">\n                        <div class=\"flex items-center gap-2 mb-0.5\" data-kid=\"111\">\n                            <span class=\"text-xs font-bold\" data-kid=\"112\">S-Oil Station #14</span>\n                            <span class=\"px-1.5 py-0.5 rounded bg-white/5 text-[#6E717C] text-[8px] font-bold uppercase\" data-kid=\"113\">Expense</span>\n                        </div>\n                        <div class=\"text-[10px] text-[#6E717C] font-medium flex items-center gap-2\" data-kid=\"114\">\n                            <span data-kid=\"115\">18:15</span>\n                            <span class=\"w-1 h-1 rounded-full bg-white/20\" data-kid=\"116\"></span>\n                            <span data-kid=\"117\">Premium Gasoline</span>\n                        </div>\n                    </div>\n                    <div class=\"text-right\" data-kid=\"118\">\n                        <div class=\"text-sm font-bold text-white\" data-kid=\"119\">-₩ 74,000</div>\n                        <div class=\"text-[9px] text-[#6E717C]\" data-kid=\"120\">Processing</div>\n                    </div>\n                </div>\n\n                \n                <div class=\"glass-panel rounded-2xl p-4 flex items-center gap-4 hover:bg-white/5 transition-all cursor-pointer group\" data-kid=\"121\">\n                    <div class=\"w-12 h-12 rounded-xl bg-white/5 flex items-center justify-center border border-white/10 group-hover:border-[#FFC700]/30 transition-all\" data-kid=\"122\">\n                        <i class=\"ti ti-car text-xl text-[#FFC700]\" data-kid=\"123\"></i>\n                    </div>\n                    <div class=\"flex-1\" data-kid=\"124\">\n                        <div class=\"flex items-center gap-2 mb-0.5\" data-kid=\"125\">\n                            <span class=\"text-xs font-bold\" data-kid=\"126\">Mapo → Seongsu-dong</span>\n                            <span class=\"px-1.5 py-0.5 rounded bg-[#FFC700]/10 text-[#FFC700] text-[8px] font-bold uppercase\" data-kid=\"127\">Business</span>\n                        </div>\n                        <div class=\"text-[10px] text-[#6E717C] font-medium flex items-center gap-2\" data-kid=\"128\">\n                            <span data-kid=\"129\">09:12 - 09:50</span>\n                            <span class=\"w-1 h-1 rounded-full bg-white/20\" data-kid=\"130\"></span>\n                            <span data-kid=\"131\">12.8 km</span>\n                        </div>\n                    </div>\n                    <div class=\"text-right\" data-kid=\"132\">\n                        <div class=\"text-sm font-bold text-[#FFC700]\" data-kid=\"133\">+₩ 22,500</div>\n                        <div class=\"text-[9px] text-[#6E717C]\" data-kid=\"134\">Settled</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    \n    <nav class=\"absolute bottom-0 left-0 right-0 glass-panel border-t border-white/10 px-6 py-4 flex justify-between items-center z-50 shadow-[0_-10px_40px_rgba(0,0,0,0.5)]\" data-kid=\"135\">\n        <div class=\"flex flex-col items-center gap-1 cursor-pointer\" data-kid=\"136\">\n            <i class=\"ti ti-home-filled text-xl text-[#FFC700]\" data-kid=\"137\"></i>\n            <span class=\"text-[9px] font-bold text-[#FFC700] tracking-tighter\" data-kid=\"138\">HOME</span>\n        </div>\n        <div class=\"flex flex-col items-center gap-1 cursor-pointer opacity-40 hover:opacity-100 transition-opacity\" data-kid=\"139\">\n            <i class=\"ti ti-list-details text-xl\" data-kid=\"140\"></i>\n            <span class=\"text-[9px] font-bold tracking-tighter text-[#9499A5]\" data-kid=\"141\">LOGS</span>\n        </div>\n        \n        <div class=\"absolute left-1/2 -translate-x-1/2 -top-7\" data-kid=\"142\">\n            <div class=\"group relative\" data-kid=\"143\">\n                <div class=\"absolute inset-0 bg-[#FFC700] rounded-full blur-lg opacity-40 group-hover:opacity-60 transition-opacity animate-pulse\" data-kid=\"144\"></div>\n                <div class=\"w-14 h-14 rounded-full bg-[#FFC700] flex items-center justify-center shadow-xl border-[6px] border-[#121418] cursor-pointer hover:scale-105 active:scale-95 transition-all relative z-10\" data-kid=\"145\">\n                    <i class=\"ti ti-plus text-black text-2xl font-extrabold\" data-kid=\"146\"></i>\n                </div>\n            </div>\n        </div>\n        <div class=\"w-12\" data-kid=\"147\"></div> \n        <div class=\"flex flex-col items-center gap-1 cursor-pointer opacity-40 hover:opacity-100 transition-opacity\" data-kid=\"148\">\n            <i class=\"ti ti-chart-bar text-xl\" data-kid=\"149\"></i>\n            <span class=\"text-[9px] font-bold tracking-tighter text-[#9499A5]\" data-kid=\"150\">STATS</span>\n        </div>\n        <div class=\"flex flex-col items-center gap-1 cursor-pointer opacity-40 hover:opacity-100 transition-opacity\" data-kid=\"151\">\n            <i class=\"ti ti-settings text-xl\" data-kid=\"152\"></i>\n            <span class=\"text-[9px] font-bold tracking-tighter text-[#9499A5]\" data-kid=\"153\">SET</span>\n        </div>\n    </nav>\n</div>\n",
