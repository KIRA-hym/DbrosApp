      "html": "\n<div class=\"w-[375px] h-[812px] bg-[#000000] text-white flex flex-col items-center justify-center relative overflow-hidden font-sans\" data-kid=\"0\">\n  \n  \n  <div class=\"relative w-[280px] h-[280px] flex items-center justify-center border border-[#FFC700]/10 bg-[#000000] overflow-hidden\" data-kid=\"1\">\n    \n    \n    <div class=\"absolute inset-0 opacity-10\" style=\"background-image: linear-gradient(#FFC700 1px, transparent 1px), linear-gradient(90deg, #FFC700 1px, transparent 1px); background-size: 20px 20px;\" data-kid=\"2\"></div>\n\n    \n    <div class=\"absolute -top-[1px] -left-[1px] w-8 h-8 border-t-[3px] border-l-[3px] border-[#FFC700] z-30 shadow-[0_0_8px_rgba(255,199,0,0.6)]\" data-kid=\"3\"></div>\n    <div class=\"absolute -top-[1px] -right-[1px] w-8 h-8 border-t-[3px] border-r-[3px] border-[#FFC700] z-30 shadow-[0_0_8px_rgba(255,199,0,0.6)]\" data-kid=\"4\"></div>\n    <div class=\"absolute -bottom-[1px] -left-[1px] w-8 h-8 border-b-[3px] border-l-[3px] border-[#FFC700] z-30 shadow-[0_0_8px_rgba(255,199,0,0.6)]\" data-kid=\"5\"></div>\n    <div class=\"absolute -bottom-[1px] -right-[1px] w-8 h-8 border-b-[3px] border-r-[3px] border-[#FFC700] z-30 shadow-[0_0_8px_rgba(255,199,0,0.6)]\" data-kid=\"6\"></div>\n\n    \n    <div class=\"absolute inset-x-0 h-[1.5px] bg-[#FFC700] shadow-[0_0_15px_#FFC700,0_0_25px_rgba(255,199,0,1)] animate-scan z-25\" data-kid=\"7\"></div>\n    \n    \n    <div class=\"absolute inset-x-0 h-48 bg-gradient-to-b from-[#FFC700]/15 via-[#FFC700]/5 to-transparent animate-scan-beam z-20 pointer-events-none\" data-kid=\"8\"></div>\n\n    \n    <div class=\"relative z-10 w-full h-full flex items-center justify-center p-6 bg-[#000000]\" data-kid=\"9\">\n      <img src=\"/api/local/images/assets/icon_before_text.png\" alt=\"Dbros Logo\" class=\"w-full h-full object-contain mix-blend-lighten filter contrast-125 brightness-110\" decoding=\"async\" loading=\"lazy\" data-kid=\"10\">\n    </div>\n\n    \n    <div class=\"absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-[1px] bg-[#FFC700]\" data-kid=\"11\"></div>\n    <div class=\"absolute top-1/2 -right-1 -translate-y-1/2 w-2 h-[1px] bg-[#FFC700]\" data-kid=\"12\"></div>\n  </div>\n\n  \n  <div class=\"mt-28 flex flex-col items-center gap-8\" data-kid=\"13\">\n    <h1 class=\"gmarket-bold text-[38px] tracking-[0.22em] text-[#FFC700] animate-glow whitespace-nowrap\" data-kid=\"14\">\n      운행일지관리\n    </h1>\n    <div class=\"flex items-center gap-3\" data-kid=\"15\">\n      <div class=\"w-1 h-1 bg-[#FFC700] rounded-full animate-ping opacity-60\" data-kid=\"16\"></div>\n      <div class=\"w-32 h-[1px] bg-gradient-to-r from-transparent via-[#FFC700]/40 to-transparent\" data-kid=\"17\"></div>\n      <div class=\"w-1 h-1 bg-[#FFC700] rounded-full animate-pulse shadow-[0_0_10px_#FFC700]\" data-kid=\"18\"></div>\n    </div>\n  </div>\n\n  <style data-kid=\"19\">\n    @font-face {\n      font-family: 'GmarketSansBold';\n      src: url('https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_2001@1.1/GmarketSansBold.woff') format('woff');\n      font-weight: 700;\n      font-style: normal;\n    }\n\n    .gmarket-bold {\n      font-family: 'GmarketSansBold', sans-serif;\n    }\n\n    @keyframes scan {\n      0% { top: 0%; opacity: 0; }\n      15% { opacity: 1; filter: brightness(1.2); }\n      85% { opacity: 1; filter: brightness(1.2); }\n      100% { top: 100%; opacity: 0; }\n    }\n\n    @keyframes scan-beam {\n      0% { top: -60px; opacity: 0; }\n      15% { opacity: 1; }\n      85% { opacity: 1; }\n      100% { top: calc(100% - 60px); opacity: 0; }\n    }\n\n    @keyframes glow-pulse {\n      0%, 100% { \n        text-shadow: 0 0 12px rgba(255, 199, 0, 0.4), 0 0 2px rgba(255, 199, 0, 0.2);\n        opacity: 0.8;\n      }\n      50% { \n        text-shadow: 0 0 20px rgba(255, 199, 0, 1), 0 0 40px rgba(255, 199, 0, 0.6), 0 0 60px rgba(255, 199, 0, 0.3);\n        opacity: 1;\n      }\n    }\n\n    .animate-scan {\n      animation: scan 4s linear infinite;\n    }\n\n    .animate-scan-beam {\n      animation: scan-beam 4s linear infinite;\n    }\n\n    .animate-glow {\n      animation: glow-pulse 2.5s ease-in-out infinite;\n    }\n  </style>\n</div>\n",
