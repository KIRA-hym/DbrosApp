<?xml version="1.0" encoding="utf-8"?>
<!-- 접힌 알림: 본문 2줄 + 우측 퀵등록 (시스템/제조사에 따라 2줄 표시) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notification_compact_line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            style="@style/TextAppearance.Compat.Notification.Title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notification_compact_line2_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="⏰ 근무시간 : "
                style="@style/TextAppearance.Compat.Notification.Line2" />

            <Chronometer
                android:id="@+id/notification_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.Compat.Notification.Line2" />

            <TextView
                android:id="@+id/notification_compact_line2_net"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:maxLines="1"
                android:textStyle="bold"
                style="@style/TextAppearance.Compat.Notification.Title" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/notification_quick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ 퀵등록"
        android:textColor="#FFC107"
        android:textStyle="bold"
        android:textSize="13sp"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:background="?android:attr/selectableItemBackgroundBorderless" />
</LinearLayout>
